table ip cozy_proxy_l4 {
	set vips {
		type ipv4_addr
		elements = { 192.0.2.10, 192.0.2.20,
			     192.0.2.30 }
	}

	set vip_ports {
		type ipv4_addr . inet_proto . inet_service
		elements = { 192.0.2.20 . tcp . 5432,
			     192.0.2.10 . tcp . 80,
			     192.0.2.10 . tcp . 443 }
	}

	set node_ips {
		type ipv4_addr
		elements = { 10.200.24.11, 10.200.24.12,
			     10.200.24.13 }
	}

	set backends {
		type ipv4_addr . inet_proto . inet_service
		elements = { 10.244.0.10 . tcp . 8080,
			     10.244.0.11 . tcp . 8080,
			     10.244.0.10 . tcp . 8443,
			     10.244.0.11 . tcp . 8443 }
	}

	map backends-192.0.2.10-tcp-80 {
		type 0 : ipv4_addr . inet_service
		comment "tenant-a/ingress"
		elements = { 0 : 10.244.0.10 . 8080,
			     1 : 10.244.0.11 . 8080 }
	}

	map backends-192.0.2.10-tcp-443 {
		type 0 : ipv4_addr . inet_service
		comment "tenant-a/ingress"
		elements = { 0 : 10.244.0.10 . 8443,
			     1 : 10.244.0.11 . 8443 }
	}

	chain guard {
		type filter hook prerouting priority mangle + 10; policy accept;
		ct state established,related accept
		ip daddr @vips ip daddr . meta l4proto . th dport != @vip_ports drop
	}

	chain translate {
		type nat hook prerouting priority dstnat - 5; policy accept;
		ip daddr 192.0.2.10 tcp dport 80 dnat ip to numgen inc mod 2 map @backends-192.0.2.10-tcp-80 comment "tenant-a/ingress"
		ip daddr 192.0.2.10 tcp dport 443 dnat ip to numgen inc mod 2 map @backends-192.0.2.10-tcp-443 comment "tenant-a/ingress"
		ip daddr 192.0.2.20 tcp dport 5432 drop comment "tenant-b/postgres"
	}

	chain masq {
		type nat hook postrouting priority srcnat - 5; policy accept;
		ct status dnat ip saddr @node_ips ip daddr . meta l4proto . th dport @backends masquerade fully-random
	}
}
